defmodule <%= @module %>.Clock do
  @moduledoc """
  The time, as a way out of the application: a test that must say what time it is expects it on
  `<%= @module %>.ClockMock`, and every other test gets the real clock (docs/elixir.md, "Ways out").
  """

  @doc "Now, in UTC."
  @callback now() :: DateTime.t()

  @doc "Today, in UTC."
  @callback today() :: Date.t()

  @impl_module Application.compile_env!(:<%= @app %>, [__MODULE__, :impl])

  @doc "The implementation `config/*.exs` chose."
  @spec current() :: module()
  def current, do: @impl_module
end

defmodule <%= @module %>.ClockImpl do
  @moduledoc false
  @behaviour <%= @module %>.Clock

  @impl true
  def now, do: DateTime.utc_now()

  @impl true
  def today, do: Date.utc_today()
end
