defmodule EventsQueueTest do
  @moduledoc """
  eh_os_contract runs a contract's effect delivered `:at_least_once` and a process manager's
  timer as Oban jobs in the queue `:events` (`EhOsContract.EffectJob`, `EhOsContract.TimerJob`).
  If Oban runs no such queue, the jobs wait in their table: the effect never happens, the timer
  never fires, and nothing fails. The other tests cannot see it, since
  `EhOsContract.Testing.drain/1` runs the queue itself, so this one reads the queues that
  `config/config.exs` gives Oban, as the test environment merges them: a `queues:` in
  `config/runtime.exs` or `config/prod.exs` is not read here.
  """

  use ExUnit.Case, async: true

  test "Oban runs the engine's queue :events" do
    queues = Application.fetch_env!(:<%= @app %>, Oban)[:queues] || []

    assert Keyword.has_key?(queues, :events)
  end
end
