defmodule <%= inspect(@module) %> do
  @moduledoc """
  Your access, at `/access`: who the person signed in through EHOS is here, and which of the
  application's capabilities their sign-in grants, beside the roles that grant each.

  ehos_app wrote it as the application's first page that needs a person, and it is the
  application's own to change or remove, with its route and its test. It sits behind the
  router's `:signed_in` pipeline (`EhOsContract.Auth.Session`), so a visitor is sent to sign in
  through EHOS and comes back to it. A person no role of the application is bound to never gets
  here: EHOS refuses them at sign-in.

  The person is read as `EhOsContract.Auth.Session.actor/1` gives them, verified as a bearer
  credential is: the credential's opaque subject and its capabilities, which is all EHOS tells
  the application about them. Nothing of EHOS's tokens reaches the page.
  """
  use <%= inspect(@web) %>, :controller

  require Logger

  alias EhOsContract.Actor
  alias EhOsContract.Auth.Session

  @doc "Shows the signed-in person their access."
  @spec show(Plug.Conn.t(), map()) :: Plug.Conn.t()
  def show(conn, _params) do
    case Session.actor(conn) do
      {:ok, actor} ->
        conn
        # Who someone is and what they may do is theirs: no cache keeps the page.
        |> put_resp_header("cache-control", "no-store")
        |> assign(:page_title, "Your access")
        |> assign(:subject, actor.subject)
        # What the `:signed_in` pipeline read, which a route outside it has not.
        |> assign(:signed_in_at, get_in(conn.assigns, [:eh_os_contract_session, :auth_time]))
        |> render(:show, access(actor, EhOsContract.Registry.contracts()))

      # The sign-in ended between the pipeline and here. As the pipeline does: a browser's
      # navigation signs in again and comes back to this page, wherever the router serves it;
      # anything else, a `fetch()`, is refused rather than sent across origins to EHOS.
      {:error, reason} when reason in [:signed_out, :expired] ->
        if navigation?(conn) do
          query = URI.encode_query(%{"return_to" => current_path(conn)})
          redirect(conn, to: "/auth/ehos/sign-in?" <> query)
        else
          conn |> put_status(401) |> text("Sign in through EHOS first.")
        end

      {:error, reason} when reason in [:ehos_unavailable, :renewal_busy] ->
        conn
        |> put_status(503)
        |> text("Signing in through EHOS is unavailable. Try again shortly.")

      # Signing in again would get the same credential: say why in the log, as the pipeline does.
      {:error, reason} ->
        Logger.warning(
          "the access page refused a signed-in person's credential: #{inspect(reason)}"
        )

        conn |> put_status(401) |> text("Sign in through EHOS first.")
    end
  end

  defp navigation?(conn) do
    get_req_header(conn, "sec-fetch-mode") == ["navigate"] or
      Enum.any?(get_req_header(conn, "accept"), &String.contains?(&1, "text/html"))
  end

  @doc """
  What `actor` may do among what `contracts` declare: each capability a person can be granted,
  by name, with its kind, the roles that grant it and whether `actor` holds it, then any the
  actor holds that no contract declares; and the application's roles. A capability the
  application takes for itself, an event it subscribes to, is no person's, and is left out.
  """
  @spec access(Actor.t(), [module()]) :: %{
          capabilities: [
            %{name: String.t(), kind: atom() | nil, roles: [String.t()], held?: boolean()}
          ],
          held: [String.t()],
          roles: [String.t()]
        }
  def access(%Actor{capabilities: held}, contracts) do
    all = Enum.reduce(contracts, %{}, &Map.merge(&2, EhOsContract.Model.capabilities(&1)))

    declared =
      for {name, %{kind: kind, roles: roles}} <- all, kind != :subscribe, into: %{} do
        {name, %{name: name, kind: kind, roles: roles, held?: MapSet.member?(held, name)}}
      end

    undeclared =
      for name <- held, not Map.has_key?(all, name), into: %{} do
        {name, %{name: name, kind: nil, roles: [], held?: true}}
      end

    capabilities = declared |> Map.merge(undeclared) |> Map.values() |> Enum.sort_by(& &1.name)

    %{
      capabilities: capabilities,
      held: for(%{held?: true, name: name} <- capabilities, do: name),
      roles: capabilities |> Enum.flat_map(& &1.roles) |> Enum.uniq() |> Enum.sort()
    }
  end
end
