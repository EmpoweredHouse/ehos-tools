defmodule <%= inspect(@module) %> do
  @moduledoc """
  The words this application's contracts share: its contexts, the glossary of each, and who acts
  in them. A word a contract names a thing with (an aggregate, a field) is a `term` of its
  context's glossary; `mix ehos_contract.check` lists, as a notice, each word no term covers.

  Its `name` is the application's name in EHOS, so its capabilities are `<%= @name %>.<command>`
  and its roles `<%= @name %>.<actor>`. The vocabulary is in `<%= @contract_docs %>`.
  """

  use EhosContract.Domain, name: <%= inspect(@name) %>, language: :en

  # `:supporting` while it holds the example alone: `mix ehos_contract.check` holds a context of
  # a `:core` subdomain to deciding, which the first one the application really runs should.
  subdomain :example, "Example", type: :supporting

  context :entries, "Entries", subdomain: :example do
    term "Entry", definition: "An amount a clerk records, which an auditor may flag"
    term "Amount", definition: "What an entry records, a whole number"
  end

  actor :clerk, :human, "Clerk"
  actor :auditor, :human, "Auditor"

  # The seed's, which records sample data in an ephemeral environment (`<%= @seed %>`). No `by:`
  # names it: it may issue each command a person may, in every scope, except what `not_seeded:`
  # lists, each with why: `not_seeded: [add_customer: "its event holds a personal field, which
  # the seed cannot seal yet"]` (ehos-tools#646).
  actor :sample_data, :seed, "Sample data", not_seeded: []
end
