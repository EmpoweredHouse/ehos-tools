defmodule <%= inspect(@module) %> do
  @moduledoc """
  Record an entry, at `/entries/new`: the example of a page that issues a command as the person
  signed in. Replace it with the application's first real form, or delete it with its route, its
  test and `<%= inspect(@context) %>`.

  The router's `:signed_in` pipeline sends a visitor to sign in through EHOS before the page is
  served. A LiveView's socket does not pass through the router's pipelines, so `mount/3` asks for
  the person again, from the session it is given. Each submit asks for the actor once more,
  with `EhOsContract.Auth.Session.actor/2`: a credential lives ten minutes, and `actor/2` renews
  it. The page hands the form's params to `<%= inspect(@context) %>`, which issues the command,
  and shows a refusal as a sentence.

  `EhOsContract.Form` checks the form against the command's declaration while the person types,
  and puts on it what the engine refused at a field. It is the person's feedback alone: the
  context is handed the params, never the form's struct, so the command is sent through
  `EhOsContract.call/3`, which asks whether the person may before it says what is wrong with
  the params.

  The form carries the entry's id, a fresh UUID when it opens, which is also the command's
  idempotency key: a second submit of the same form records nothing more, and an accepted one
  opens a new form. The id is in the form, not only in the socket, so a form LiveView recovers
  after a reconnect keeps it (`phx-change`), and a submit sent again then is a duplicate too. The
  person can change it, as a caller of `/api` can name any id: only the contract guards an entry
  that exists.
  """

  use <%= inspect(@web) %>, :live_view

  require Logger

  alias EhOsContract.Auth.Session
  alias EhOsContract.Form
  alias <%= inspect(@context) %>

  # The command the form is checked against, by the name the context issues it by.
  @command {:command, "<%= @name %>.record_entry"}

  @impl true
  def mount(_params, session, socket) do
    socket =
      socket
      |> assign(:page_title, "Record an entry")
      # The token naming the person's session alone, none of EHOS's: `actor/2` reads it.
      |> assign(:session, Map.take(session, [Session.session_key()]))
      |> new_form()

    case Session.actor(session) do
      {:ok, _actor} -> {:ok, socket}
      {:error, reason} -> {:ok, refused(socket, reason)}
    end
  end

  # Keeps what the form holds, its id included: LiveView sends it again as a change once a
  # dropped socket reconnects.
  @impl true
  def handle_event("change", %{"entry" => params}, socket) when is_map(params),
    do: {:noreply, assign(socket, :form, form(Form.changeset(@command, params), :validate))}

  def handle_event("record", %{"entry" => params}, socket) when is_map(params) do
    with {:ok, actor} <- Session.actor(socket.assigns.session),
         {:ok, _receipt} <- Entries.record_entry(actor, params) do
      {:noreply, socket |> put_flash(:info, "The entry is recorded.") |> new_form()}
    else
      {:error, reason} -> {:noreply, socket |> refused_form(params, reason) |> refused(reason)}
    end
  end

  # No browser sends an entry that is not a map, nor none, and `Form.changeset/2` raises on one.
  # Such a change leaves the form as it was, its id included; such a submit is sent as an empty
  # entry, which the engine refuses after it asks whether the person may.
  def handle_event("change", _params, socket), do: {:noreply, socket}

  def handle_event("record", _params, socket),
    do: handle_event("record", %{"entry" => %{}}, socket)

  @impl true
  def render(assigns) do
    ~H"""
    <Layouts.app flash={@flash}>
      <.header>
        Record an entry
        <:subtitle>A clerk records an amount; the engine refuses anyone else.</:subtitle>
      </.header>

      <.form for={@form} id="entry-form" phx-change="change" phx-submit="record" class="max-w-md">
        <input type="hidden" name={@form[:entry_id].name} value={shown(@form[:entry_id].value)} />
        <.input
          field={@form[:amount]}
          value={shown(@form[:amount].value)}
          type="number"
          label="Amount"
          required
        />
        <.button variant="primary" phx-disable-with="Recording…">Record the entry</.button>
      </.form>
    </Layouts.app>
    """
  end

  defp new_form(socket) do
    changeset = Form.changeset(@command, %{"entry_id" => Ecto.UUID.generate()})
    assign(socket, :form, form(changeset, nil))
  end

  # A refusal at a field shows at that field, and the flash says every refusal in a sentence.
  defp refused_form(socket, params, reason) do
    changeset = @command |> Form.changeset(params) |> on_form(reason)
    assign(socket, :form, form(changeset, :validate))
  end

  # The form's own errors alone while it has any: the engine refuses the same fields, and its
  # refusal on them would show each error twice.
  defp on_form(%Ecto.Changeset{valid?: false} = changeset, _reason), do: changeset
  defp on_form(changeset, reason), do: Form.refused(changeset, reason)

  defp form(changeset, action), do: to_form(changeset, as: :entry, action: action)

  # A field as the form holds it, if it is text or the number read from it: a client can send a
  # map or a list in its place, which the form refused and no input can show.
  defp shown(value) when is_binary(value) or is_integer(value), do: value
  defp shown(_value), do: nil

  # The sign-in ended: the browser signs in again and comes back here.
  defp refused(socket, reason) when reason in [:signed_out, :expired] do
    query = URI.encode_query(%{"return_to" => ~p"/entries/new"})
    redirect(socket, to: "/auth/ehos/sign-in?" <> query)
  end

  defp refused(socket, reason), do: put_flash(socket, :error, sentence(reason))

  defp sentence(:missing_capability),
    do: "You cannot record an entry: your sign-in does not grant it. Ask for the Clerk role."

  defp sentence({:invalid, _problems}),
    do: "The entry was not recorded: what the form sent is not an entry. Check the amount."

  # An id the engine cannot key a command by is the form's too.
  defp sentence(:idempotency_key_invalid), do: sentence({:invalid, []})

  defp sentence(reason) when reason in [:ehos_unavailable, :renewal_busy],
    do: "Signing in through EHOS is unavailable. Try again shortly."

  # Any other refusal is named in the log by its kind alone, never a value it carries.
  defp sentence(reason) do
    Logger.warning("the entry form was refused: #{kind(reason)}")
    "The entry was not recorded. Try again, or tell the application's owner."
  end

  defp kind(%{__struct__: struct}), do: inspect(struct)
  defp kind({kind, _detail}) when is_atom(kind), do: Atom.to_string(kind)
  defp kind(kind) when is_atom(kind), do: Atom.to_string(kind)
  defp kind(_reason), do: "unknown"
end
