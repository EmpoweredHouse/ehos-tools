defmodule <%= inspect(@module) %> do
  @moduledoc """
  An example contract, generated so the tooling has something to read on day one: a clerk
  records an entry, under a fresh `entry_id` the caller gives, and an auditor flags one. Replace
  it with the first unit the application actually decides over; the vocabulary is in
  `<%= @contract_docs %>`. A run of the business across contracts is a module of its own, `use
  EhOsContract.Process`.
  """

  # The id types every event this contract records ("<%= @id %>.<event>"): renaming it later
  # leaves the log's earlier rows unread as those events.
  use EhOsContract.Contract, domain: <%= inspect(@domain) %>, context: :entries, id: "<%= @id %>"

  aggregate :entry, "Entry" do
    # The caller gives the entry's identity: it is not `generated: :uuid` with a `creates:`
    # command, which together would have the engine generate it. So a call without `entry_id` is
    # refused as invalid. Give each new entry a fresh id, a UUID: an id in use records onto that
    # entry, and `Entry` does not read its state, so even onto a flagged one. A UUID only avoids
    # collisions; it does not guard an entry, since whoever may `record_entry` may name any id.
    identity :entry_id

    command :record_entry, "Record an entry", by: [:clerk, :sample_data], emits: :recorded do
      field :amount, :integer
    end

    command :flag_entry, "Flag an entry", by: [:auditor, :sample_data], emits: :flagged

    event :recorded, "Entry recorded" do
      field :amount, :integer
    end

    event :flagged, "Entry flagged"
  end

  # What other applications may learn of an entry: the one way an event leaves this one.
  publish :entry_recorded,
    as: "<%= @publication %>",
    from: :recorded,
    fields: [:entry_id, :amount]

  publish :entry_flagged,
    as: "<%= @flagged_publication %>",
    from: :flagged,
    fields: [:entry_id]
end
