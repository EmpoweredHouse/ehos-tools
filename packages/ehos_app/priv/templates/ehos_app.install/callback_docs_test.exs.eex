defmodule CallbackDocsTest do
  @moduledoc """
  The rule of docs/elixir.md, "Behaviours", a test can hold: every `@callback` of the
  application's behaviours has a `@doc` saying what it does, what it answers and how it fails. A
  mock is held to a callback's types, never to its words, so the words are what a caller reads.
  """

  use ExUnit.Case, async: true

  test "every callback of the application's behaviours has a @doc" do
    {:ok, modules} = :application.get_key(:<%= @app %>, :modules)

    missing =
      for module <- modules,
          Code.ensure_loaded?(module),
          function_exported?(module, :behaviour_info, 1),
          {name, arity} <- module.behaviour_info(:callbacks),
          not documented?(module, name, arity),
          do: "#{inspect(module)}.#{name}/#{arity}"

    assert modules != []
    assert missing == []
  end

  # `@doc false` reads as hidden, and a callback with no `@doc` as none: both are missing.
  defp documented?(module, name, arity) do
    {:docs_v1, _, _, _, _, _, docs} = Code.fetch_docs(module)
    Enum.any?(docs, &match?({{:callback, ^name, ^arity}, _, _, %{}, _}, &1))
  end
end
