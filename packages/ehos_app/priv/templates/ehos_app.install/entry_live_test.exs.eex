defmodule <%= inspect(@module) %> do
  # Every append to the engine's log takes one lock, held for the sandbox's whole transaction.
  use <%= inspect(@conn_case) %>, async: false
  use EhOsContract.Auth.Testing

  import Phoenix.LiveViewTest

  alias EhOsContract.Auth.Session

  test "a clerk records an entry, and a new form opens", %{conn: conn} do
    {:ok, view, _html} =
      conn |> signed_in(["<%= @name %>.record_entry"]) |> live(~p"/entries/new")

    view |> form("#entry-form", entry: %{amount: "120"}) |> render_submit()

    assert has_element?(view, "#flash-info", "The entry is recorded.")
    assert recorded() == 1
  end

  test "an amount that is not a whole number is shown as invalid while the person types", %{
    conn: conn
  } do
    {:ok, view, _html} =
      conn |> signed_in(["<%= @name %>.record_entry"]) |> live(~p"/entries/new")

    html = view |> form("#entry-form", entry: %{amount: "twelve"}) |> render_change()

    assert html =~ "is invalid"
    assert recorded() == 0
  end

  test "an amount the browser sends but the contract refuses is shown as invalid once", %{
    conn: conn
  } do
    {:ok, view, _html} =
      conn |> signed_in(["<%= @name %>.record_entry"]) |> live(~p"/entries/new")

    params = %{"entry" => %{"amount" => "1e3"}}
    html = render_submit(view, "record", params)

    assert html |> String.split("is invalid") |> length() == 2
    assert recorded() == 0
  end

  test "a second submit of the same form records nothing more", %{conn: conn} do
    {:ok, view, _html} =
      conn |> signed_in(["<%= @name %>.record_entry"]) |> live(~p"/entries/new")

    params = %{"entry_id" => entry_id(view), "entry" => %{"amount" => "120"}}

    render_submit(view, "record", params)
    render_submit(view, "record", params)

    assert recorded() == 1
  end

  test "an entry id the person sends in the entry is not read, so naming another records nothing more",
       %{conn: conn} do
    {:ok, view, _html} =
      conn |> signed_in(["<%= @name %>.record_entry"]) |> live(~p"/entries/new")

    first = %{"entry_id" => entry_id(view), "entry" => %{"entry_id" => "e-1", "amount" => "120"}}
    render_submit(view, "record", first)
    render_submit(view, "record", put_in(first, ["entry", "entry_id"], "e-2"))

    assert recorded() == 1
  end

  test "a form recovered after a reconnect keeps its id, so sending it again records nothing more",
       %{conn: conn} do
    {:ok, view, _html} =
      conn |> signed_in(["<%= @name %>.record_entry"]) |> live(~p"/entries/new")

    params = %{"entry_id" => entry_id(view), "entry" => %{"amount" => "120"}}
    render_submit(view, "record", params)

    # A new socket, as after a reconnect: LiveView sends the form it recovered as a change.
    {:ok, view, _html} =
      conn |> signed_in(["<%= @name %>.record_entry"]) |> live(~p"/entries/new")

    render_change(view, "change", params)
    view |> form("#entry-form") |> render_submit()

    assert recorded() == 1
  end

  test "an id that is not a UUID is not taken back from a change", %{conn: conn} do
    {:ok, view, _html} =
      conn |> signed_in(["<%= @name %>.record_entry"]) |> live(~p"/entries/new")

    entry_id = entry_id(view)
    render_change(view, "change", %{"entry_id" => "e-1", "entry" => %{"amount" => "120"}})

    assert entry_id(view) == entry_id
  end

  test "a person whose sign-in does not grant recording is refused, and nothing is recorded", %{
    conn: conn
  } do
    {:ok, view, _html} =
      conn |> signed_in(["<%= @name %>.flag_entry"]) |> live(~p"/entries/new")

    view |> form("#entry-form", entry: %{amount: "120"}) |> render_submit()

    assert has_element?(view, "#flash-error", "You cannot record an entry")
    assert recorded() == 0
  end

  test "an amount sent as a map is shown as invalid while the person types", %{conn: conn} do
    {:ok, view, _html} =
      conn |> signed_in(["<%= @name %>.record_entry"]) |> live(~p"/entries/new")

    params = %{"entry" => %{"amount" => %{"x" => "1"}}}
    html = render_change(view, "change", params)

    assert html =~ "is invalid"
    assert recorded() == 0
  end

  test "an amount sent as a map is refused, and nothing is recorded", %{conn: conn} do
    {:ok, view, _html} =
      conn |> signed_in(["<%= @name %>.record_entry"]) |> live(~p"/entries/new")

    params = %{"entry" => %{"amount" => %{"x" => "1"}}}
    render_submit(view, "record", params)

    assert has_element?(view, "#flash-error", "what the form sent is not an entry")
    assert recorded() == 0
  end

  test "an entry sent as text while the person types leaves the form as it was", %{conn: conn} do
    {:ok, view, _html} =
      conn |> signed_in(["<%= @name %>.record_entry"]) |> live(~p"/entries/new")

    entry_id = entry_id(view)
    render_change(view, "change", %{"entry_id" => Ecto.UUID.generate(), "entry" => "foo"})

    assert entry_id(view) == entry_id
    assert recorded() == 0
  end

  test "an entry sent as text is refused, and nothing is recorded", %{conn: conn} do
    {:ok, view, _html} =
      conn |> signed_in(["<%= @name %>.record_entry"]) |> live(~p"/entries/new")

    render_submit(view, "record", %{"entry" => "foo"})

    assert has_element?(view, "#flash-error", "what the form sent is not an entry")
    assert recorded() == 0
  end

  test "a submit without an entry is refused, and nothing is recorded", %{conn: conn} do
    {:ok, view, _html} =
      conn |> signed_in(["<%= @name %>.record_entry"]) |> live(~p"/entries/new")

    render_submit(view, "record", %{})

    assert has_element?(view, "#flash-error", "what the form sent is not an entry")
    assert recorded() == 0
  end

  test "an entry sent as text by a person who may not record is refused as such", %{conn: conn} do
    {:ok, view, _html} =
      conn |> signed_in(["<%= @name %>.flag_entry"]) |> live(~p"/entries/new")

    render_submit(view, "record", %{"entry" => "foo"})

    assert has_element?(view, "#flash-error", "You cannot record an entry")
    assert recorded() == 0
  end

  test "an amount longer than the engine reads is refused, even when it is a whole number", %{
    conn: conn
  } do
    {:ok, view, _html} =
      conn |> signed_in(["<%= @name %>.record_entry"]) |> live(~p"/entries/new")

    # 21 characters that parse as 1: the engine leaves text this long unread, as the page does.
    amount = "000000000000000000001"
    params = %{"entry" => %{"amount" => amount}}
    render_submit(view, "record", params)

    assert has_element?(view, "#flash-error", "what the form sent is not an entry")
    assert recorded() == 0
  end

  test "a visitor's browser is sent to sign in through EHOS, and back to the form", %{
    conn: conn
  } do
    conn = conn |> put_req_header("accept", "text/html") |> get(~p"/entries/new")

    assert redirected_to(conn, 302) == "/auth/ehos/sign-in?return_to=%2Fentries%2Fnew"
  end

  # Signed in as a sign-in through EHOS signs a browser in, with no EHOS: the session row holds a
  # credential `EhOsContract.Auth.Testing` issued, which the page's actor is read from.
  defp signed_in(conn, capabilities) do
    token = sign_in("u-person", capabilities)
    Plug.Test.init_test_session(conn, %{Session.session_key() => token})
  end

  defp recorded, do: <%= inspect(@repo) %>.aggregate(EhOsContract.Event, :count)

  defp entry_id(view) do
    input = view |> element("#entry-form input[name=entry_id]") |> render()
    [value] = input |> LazyHTML.from_fragment() |> LazyHTML.attribute("value")
    value
  end
end
