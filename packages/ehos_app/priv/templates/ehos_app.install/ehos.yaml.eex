# What this application needs from EHOS, and nothing about how EHOS provides it: no
# hosts, no connection strings, no secret values, no Kubernetes. EHOS reads this file
# from Stage 6 of its roadmap; until then it documents intent and nothing enforces it.
# The fields themselves follow EHOS's architecture (§5.1) and are a guess until then.
app: <%= @app %>
needs:
  # A guess: EHOS has not fixed which database versions it provides.
  database: postgres >= 16
publishes: []
serves:
  # A guess: Phoenix's default port, served publicly. EHOS has not fixed how an
  # application's ports are declared.
  - {name: web, port: 4000, public: true}
# Not served yet: the template does not generate these endpoints so far.
health: {ready: /health/ready, live: /health/live}
