# What this application needs from EHOS in order to run, and nothing about how EHOS provides
# it. EHOS defines this format, https://github.com/empoweredhouse/eh-os/blob/main/docs/ehos-yaml.md
# explains every field, and the schema below is EHOS's, as eh_os_contract_auth carries it: an
# editor finds it once `mix deps.get` has run. The application's name is its contract domain's,
# so it is not written here.
# yaml-language-server: $schema=<%= @schema %>
schema: <%= @version %>
needs:
  database:
    engine: postgres
    version: ">= 16"
    migrate: [/app/bin/migrate]
    # Run in an ephemeral environment only, never in production, after the migration and at
    # every start, so it must be idempotent: priv/repo/seeds.exs, through <%= @seed %>.
    seed: [/app/bin/<%= @app %>, eval, "<%= @seed %>.run()"]
serves:
  - name: web
    port: <%= @web_port %>
    public: true
# People sign in to the pages `web` serves through EHOS, which returns them there. `{}` asks for
# this application's credential alone; `applications:` names the others the pages call as the
# person, each of which agrees on its own side in EHOS first.
sign_in: {}
health:
  port: <%= @health_port %>
  ready: /health/ready
  live: /health/live
