# What this application needs from EHOS in order to run, and nothing about how EHOS provides
# it. EHOS defines this format: the schema beside it, in .ehos/, is a copy of the one it
# publishes, and https://github.com/empoweredhouse/eh-os/blob/main/docs/ehos-yaml.md explains
# every field. The application's name is its contract domain's, so it is not written here.
# yaml-language-server: $schema=.ehos/ehos.yaml.v2.json
schema: ehos.yaml/v2
needs:
  database:
    engine: postgres
    version: ">= 16"
    migrate: [/app/bin/migrate]
serves:
  - name: web
    port: <%= @web_port %>
    public: true
# People sign in to the pages `web` serves through EHOS, which returns them there. `{}` asks for
# this application's credential alone; `applications:` names the others the pages call as the
# person, each of which agrees on its own side in EHOS first.
sign_in: {}
health:
  port: <%= @health_port %>
  ready: /health/ready
  live: /health/live
