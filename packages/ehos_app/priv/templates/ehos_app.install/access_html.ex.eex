defmodule <%= inspect(@module) %> do
  @moduledoc """
  The page of `<%= inspect(@web) %>.AccessController`: who the person signed in through EHOS is
  here, and which of the application's capabilities their sign-in grants.
  """
  use <%= inspect(@web) %>, :html

  @doc "The page, from `<%= @name %>.Access.of/1`'s answer, the subject and the sign-in's time."
  attr :flash, :map, required: true
  attr :subject, :string, required: true
  attr :signed_in_at, DateTime, default: nil
  attr :capabilities, :list, required: true
  attr :held, :list, required: true
  attr :roles, :list, required: true

  def show(assigns) do
    ~H"""
    <Layouts.flash_group flash={@flash} />
    <main id="access" class="px-4 py-20 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl space-y-8">
        <.header>
          Your access
          <:subtitle>
            What EHOS lets you do in <%= @name %>, by the roles bound to you there.
          </:subtitle>
        </.header>

        <.list>
          <:item title="Signed in as">
            <span id="access-subject" class="eh-record">{@subject}</span>
          </:item>
          <:item :if={@signed_in_at} title="Signed in at">
            <span class="eh-record">{Calendar.strftime(@signed_in_at, "%Y-%m-%d %H:%M UTC")}</span>
          </:item>
        </.list>

        <section :if={@held == []} id="access-none" class="space-y-2">
          <h2 class="eh-h3">Nothing here yet</h2>
          <p class="eh-body text-fg-secondary">
            Your sign-in grants none of this application's capabilities. Whoever manages roles in
            EHOS can bind you one of its roles<span :if={@roles != []}>:
              <span class="eh-record">{Enum.join(@roles, ", ")}</span></span>.
          </p>
        </section>

        <section :if={@capabilities != []} id="access-capabilities" class="space-y-4">
          <h2 class="eh-h3">What people may do here</h2>
          <.table id="access-table" rows={@capabilities} row_id={&"capability-#{&1.name}"}>
            <:col :let={capability} label="Capability">
              <span class="eh-record">{capability.name}</span>
            </:col>
            <:col :let={capability} label="Kind">{capability.kind}</:col>
            <:col :let={capability} label="Granted by">
              <span class="eh-record">{Enum.join(capability.roles, ", ")}</span>
            </:col>
            <:col :let={capability} label="Yours">
              <span class={if(capability.held?, do: "text-accent-ink", else: "text-fg-tertiary")}>
                {if(capability.held?, do: "Yes", else: "No")}
              </span>
            </:col>
          </.table>
        </section>

        <.button id="access-home" href={~p"/"}>Home</.button>
      </div>
    </main>
    """
  end
end
