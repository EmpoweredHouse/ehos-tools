defmodule <%= inspect(@module) %> do
  use <%= inspect(@conn_case) %>, async: true

  import Phoenix.LiveViewTest, only: [render_component: 2]

  alias EhOsContract.Auth.Session

  # The way in and out is in the root layout, which every page renders, so the tests render
  # the layout rather than a page: replacing the home page leaves them as they are.
  defp root_layout(conn) do
    render_component(&<%= inspect(@layouts) %>.root/1, conn: conn, inner_content: "")
    |> LazyHTML.from_document()
  end

  test "the root layout offers a visitor to sign in through EHOS", %{conn: conn} do
    document = conn |> init_test_session(%{}) |> root_layout()

    assert document |> LazyHTML.query(~s|a#sign-in[href="/auth/ehos/sign-in"]|) |> Enum.any?()
    refute document |> LazyHTML.query("#sign-out") |> Enum.any?()
  end

  test "the root layout offers a signed-in browser to sign out, behind CSRF protection", %{
    conn: conn
  } do
    document = conn |> init_test_session(%{Session.session_key() => "a session"}) |> root_layout()

    assert document
           |> LazyHTML.query(~s|form#sign-out[action="/auth/ehos/sign-out"][method="post"]|)
           |> Enum.any?()

    assert document |> LazyHTML.query(~s|#sign-out input[name="_csrf_token"]|) |> Enum.any?()
  end

  # An error page Phoenix renders before the router's pipeline ran has no session.
  test "the way in and out renders nothing where the session was never fetched", %{conn: conn} do
    html = render_component(&<%= inspect(@components) %>.sign_in_or_out/1, conn: conn)

    refute html =~ "sign-in"
  end

  # In tests there is no EHOS to sign in with: the sign-in is served,
  # and answers as it does while EHOS cannot be reached, which it logs.
  @tag :capture_log
  test "signing in is served, and waits for EHOS", %{conn: conn} do
    assert conn |> get("/auth/ehos/sign-in") |> response(503)
  end

  # eh-os D-166: the development mode signs people in with a key the application makes itself,
  # so its page and endpoint are compiled where `dev_routes` is set alone, and only
  # config/dev.exs turns it on. A release reads config.exs with prod.exs, then runtime.exs.
  test "the development sign-in is neither compiled nor turned on outside development" do
    for path <- ["/dev/sign-in", "/dev/credential"] do
      assert Phoenix.Router.route_info(<%= inspect(@router) %>, "GET", path, "localhost") == :error
    end

    release = Config.Reader.read!("config/config.exs", env: :prod, target: :host)

    refute release[:<%= @app %>][:dev_routes]
    refute release[:eh_os_contract_auth][:development]
    refute File.read!("config/runtime.exs") =~ ~r/\bdevelopment:/
  end
end
